[Unit]
Description=Mutual Fund AMC Master Pipeline Schedule (IST)
After=network.target

[Timer]
# Monthly SEBI Disclosure Window: Strictly 7th to 12th of every month
# Runs at 07:00, 15:00, and 23:00 IST
OnCalendar=*-*-07..12 07,15,23:00:00

# Run immediately if a scheduled execution was missed
Persistent=true

[Install]
WantedBy=timers.target
