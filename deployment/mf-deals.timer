[Unit]
Description=Automated Bulk & Block Deals Sync Timer (Intraday Block Windows & Post-Market Bulk Disclosures)
Requires=mf-deals.service

[Timer]
Unit=mf-deals.service
OnCalendar=Mon..Fri 09:30:00 Asia/Kolkata
OnCalendar=Mon..Fri 14:45:00 Asia/Kolkata
OnCalendar=Mon..Fri 17:00:00 Asia/Kolkata
OnCalendar=Mon..Fri 18:30:00 Asia/Kolkata
OnCalendar=Mon..Fri 20:00:00 Asia/Kolkata
OnCalendar=Mon..Fri 21:30:00 Asia/Kolkata
Persistent=true

[Install]
WantedBy=timers.target
