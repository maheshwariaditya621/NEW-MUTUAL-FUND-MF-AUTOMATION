[Unit]
Description=AV Fincorp Mutual Fund Manager Intelligence Weekly Synchronization
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/mf-app
ExecStart=/home/ubuntu/mf-app/.venv/bin/python -m src.scheduler.fund_manager_scheduler
StandardOutput=journal
StandardError=journal
Restart=no

[Install]
WantedBy=multi-user.target
