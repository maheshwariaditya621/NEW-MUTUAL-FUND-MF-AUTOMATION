[Unit]
Description=AV Fincorp Automated Bulk & Block Deals Synchronization
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/mf-app
ExecStart=/home/ubuntu/mf-app/.venv/bin/python -m src.deals.engine --mode sync --days 5
StandardOutput=journal
StandardError=journal
Restart=no

[Install]
WantedBy=multi-user.target
