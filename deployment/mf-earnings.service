[Unit]
Description=AV Fincorp Automated Company Earnings Calendar & Results Synchronization
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/mf-app
ExecStart=/home/ubuntu/mf-app/.venv/bin/python -m src.earnings.engine
StandardOutput=journal
StandardError=journal
Restart=no

[Install]
WantedBy=multi-user.target
